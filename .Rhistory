geom_bar(data = toplot %>% filter(incomelevel == "Low income"),
aes(y = forcats::fct_reorder(country, desc(ordervar)),
x = afs_VA_perworker, fill = fillvar),
stat = "identity") +
geom_point(data = toplot2 %>% filter(incomelevel == "Low income"),
aes(y = country, x = VA_perworker,
shape = Type, color = Type),
size = 2, show.legend = TRUE) +
scale_shape_manual(values = c(15, 17)) +
scale_fill_manual("", values = c("gray90")) +
theme_classic() +
labs(x = "", y = "") +
# Make the thousands separator a space per FAO formatting
scale_y_continuous(
labels = label_number(big.mark = " ")) +
theme(plot.title = element_text(size = 8),
plot.margin = unit(c(0,0,0,0), "cm"),
axis.text.x = element_text(size = 6),
axis.text.y = element_text(size = 6),
legend.position = "right",
legend.direction = "horizontal",
legend.spacing = unit(0.02, "cm"),
legend.title = element_blank()) +
guides(fill = guide_legend(override.aes = list(size = 4, shape = NA),
keyheight = .1),
shape = guide_legend(override.aes = list(size = 4),
keyheight = .5),
color = guide_legend(override.aes = list(size = 4),
keyheight = .5))
# Get the legend
legend <- cowplot::get_legend(p1)
