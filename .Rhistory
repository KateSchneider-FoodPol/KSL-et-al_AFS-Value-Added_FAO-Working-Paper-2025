# Get the legend
# Create the plot
# to fake the fill legend, add a variable:
toplot <- toplot %>%
mutate(fillvar = "Total Agrifood Systems",
fillvar = as.factor(fillvar))
p1 <- ggplot(data = toplot %>% filter(incomelevel == "Low income")) +
geom_bar(data = toplot %>% filter(incomelevel == "Low income"),
aes(y = forcats::fct_reorder(country, desc(ordervar)),
x = afs_VA_perworker, fill = fillvar),
stat = "identity") +
geom_point(data = toplot2 %>% filter(incomelevel == "Low income"),
aes(y = country, x = VA_perworker,
shape = Type, color = Type),
size = 2, show.legend = TRUE) +
scale_shape_manual(values = c(15, 17)) +
scale_fill_manual("", values = c("gray90")) +
theme_classic() +
labs(x = "", y = "") +
theme(plot.title = element_text(size = 8),
plot.margin = unit(c(0,0,0,0), "cm"),
axis.text.x = element_text(size = 6),
axis.text.y = element_text(size = 6),
legend.position = "right",
legend.direction = "horizontal",
legend.spacing = unit(0.02, "cm"),
legend.title = element_blank()) +
guides(fill = guide_legend(override.aes = list(size = 4, shape = NA),
keyheight = .1),
shape = guide_legend(override.aes = list(size = 4),
keyheight = .5),
color = guide_legend(override.aes = list(size = 4),
keyheight = .5))
# Get the legend
legend <- cowplot::get_legend(p1)
# Combine the plots
plot1 <- cowplot::plot_grid(plotlist = plot_list, nrow = 2, align = "hv", rel_widths = c(1,1))
# Add a single x-axis label to the bottom right
text <- "Value added per worker (current USD)"
tgrob <- text_grob(text, size = 8, color = "black")
label <- as_ggplot(tgrob) + theme(plot.margin = unit(c(0, 0, 0, 0), "cm"))
plot2 <- cowplot::plot_grid(plot1, label, nrow = 2, rel_heights = c(30,0.85))
# Combine
cowplot::plot_grid(plot2, legend, ncol = 1, rel_heights = c(19,1), align = "vh")
# Save the plot as .png (because elements are overlapping in viewer)
ggsave(file = file.path(fig_out, "ESSWP_Figure 9.png"), plot = last_plot(), width = 7.5, height = 9.5, units = c("in"), dpi = 300)
# Clean up
rm(toplot, incomegroup_list, income_plot, plot_list, p1, tgrob, label, text, text2, label2, labels, plot2, legend)
