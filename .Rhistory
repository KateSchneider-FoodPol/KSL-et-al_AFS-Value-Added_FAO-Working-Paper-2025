}
# Use the map function to run the plot function for every continent
plot_list <- map(incomegroup_list, income_plot)
# Share of GDP from agrifood systems by AFS sector, country, and income group, 2019
# Set up the data
toplot <- VAperworker %>%
filter(Year == 2019 & country %in% countries_2019_pw) %>%
select(c(1:3,14,19, 20, 24)) %>%
rename(incomelevel = "Income Level") %>%
filter(!(is.na(incomelevel))) %>%
mutate(incomelevel = factor(incomelevel,
levels = c("Low income",
"Lower middle income",
"Upper middle income",
"High income"))) %>%
group_by(incomelevel) %>%
arrange(incomelevel, desc(afs_VA_perworker)) %>%
mutate(ordervar = 1:n()) %>%
ungroup() %>%
mutate(afs_VA_perworker = round(afs_VA_perworker, 2),
PPtoRest_VApw_ratio = round(PPtoRest_VApw_ratio, 2)) %>%
select(c(1,4,6,7,8)) %>%
# Rename income levels for FAO conventions:
mutate(incomelevel = case_when(incomelevel == "Lower middle income" ~ "Lower-middle income",
incomelevel == "Upper middle income" ~ "Upper-middle income",
TRUE ~ incomelevel))
toplot2 <- VAperworker %>%
filter(Year == 2019 & country %in% countries_2019_pw) %>%
select(c(1:3, 12:15,19, 20, 23)) %>%
rename(`Primary production` = ag_VA_perworker,
`Rest of agrifood systems` = nonagAFS_VA_perworker) %>%
rename(incomelevel = "Income Level") %>%
filter(!(is.na(incomelevel))) %>%
mutate(incomelevel = factor(incomelevel,
levels = c("Low income",
"Lower middle income",
"Upper middle income",
"High income"))) %>%
pivot_longer(4:5, names_to = "Type", values_to = "VA_perworker") %>%
filter(!(is.na(VA_perworker))) %>%
mutate(VA_perworker = round(VA_perworker, 2),
Type = as.factor(Type)) %>%
select(c(1,7,9,10)) %>%
# Rename income levels for FAO conventions:
mutate(incomelevel = case_when(incomelevel == "Lower middle income" ~ "Lower-middle income",
incomelevel == "Upper middle income" ~ "Upper-middle income",
TRUE ~ incomelevel))
# Create a separate plot for each region with every country
# Create list of income groups
incomegroup_list <- unique(toplot$incomelevel)
# Assign the plot code into a function
income_plot <- function(x){
part1 <- ggplot(data = toplot %>% filter(incomelevel == x)) +
geom_bar(data = toplot %>% filter(incomelevel == x),
aes(y = forcats::fct_reorder(country, desc(ordervar)),
x = afs_VA_perworker),
stat = "identity",
fill = "gray90",
show.legend = FALSE) +
geom_point(data = toplot2 %>% filter(incomelevel == x),
aes(y = country, x = VA_perworker,
shape = Type, color = Type),
show.legend = FALSE) +
scale_shape_manual(values = c(15, 17)) +
theme_classic() +
theme(plot.margin = unit(c(0.1,0.2,0.1,0), "cm"),
legend.position="none",
axis.text.x = element_text(size = 5),
axis.text.y = element_text(size = 6)) +
guides(shape = FALSE, color = FALSE) +
labs(x = "", y = "") +
ggtitle(paste0(x)) +
theme(plot.title = element_text(size = 8))
part2 <- ggplot(data = toplot %>% filter(incomelevel == x)) +
geom_text(aes(y = forcats::fct_reorder(country, desc(ordervar)),
x = 1,
label = PPtoRest_VApw_ratio),
colour = "black", size = 1.9,
hjust = 1) +
scale_x_continuous(position = "top", expand = c(0,0)) +
labs(x = "Ratio", y = "") +
theme_classic() +
# Make the thousands separator a space per FAO formatting
scale_y_continuous(
labels = label_number(big.mark = " ")) +
theme(plot.margin = unit(c(0,0,0,0), "cm"),
legend.position="none",
axis.title.x = element_text(size = 6, hjust = 0.175),
axis.text.x = element_blank(),
axis.text.y = element_blank(),
axis.ticks.x=element_blank(),
axis.ticks.y=element_blank(),
axis.line = element_blank())
cowplot::plot_grid(part1, part2, ncol = 2, rel_widths = c(5,1),
align = "h")
}
