labs(y = ("Share of primary production consumed (%)"))
p1 <- ggplot(toplot2, aes(y=val_pct, x=Year, fill = to)) +
geom_col(aes(fill = to)) +
scale_fill_manual(labels = function(to) str_wrap(to, width = 30),
values = colors_IOsectors) +
theme_classic() +
theme(legend.text = element_text(size = 10),
legend.position="right") +
guides(fill = guide_legend(title = "Sector (EORA)",
override.aes = list(size = 3),
ncol = 1, keyheight = 0.5))
legend <- get_legend(p1)
# Combine plot and legend
plot_grid(plot, legend, nrow = 1, rel_widths = c(7.5,3))
# Save the plot as .png
ggsave(file = file.path(fig_out, "Figure S4.png"), plot = last_plot(), width = 8, height = 8, units = c("in"),dpi = 300)
# Set up the data
tabledata <- AFS_ValueAdded %>%
select(c(country, Year, manufacturing_flag)) %>%
arrange(country, Year) %>%
filter(!(is.na(manufacturing_flag))) %>%
group_by(country, manufacturing_flag) %>%
rename(Country = country) %>%
mutate(manufacturing_flag = case_when(
manufacturing_flag == "UNIDO Observed" ~ "UNIDO",
TRUE ~ manufacturing_flag)) %>%
unique()
# Print it as a heatmap
ggplot(tabledata, aes(y = factor(Country, levels = rev(levels(factor(Country)))),
x = factor(Year), fill = manufacturing_flag)) +
geom_tile() +
scale_fill_brewer(palette = "Paired") +
theme_classic() +
theme(axis.text.x = element_text(size = 6, angle = 90, vjust = 0.5),
axis.text.y = element_text(size = 4),
legend.position = "bottom") +
labs(x = "", y = "", fill = "Source of manufacturing data")
# Save the plot as .png
ggsave(file = file.path(fig_out, "Figure S5.png"), plot = last_plot(), width = 5, height = 8, units = c("in"),dpi = 300)
# Clean up
rm(tabledata)
# Set up the data
data <- AFS_ValueAdded %>%
filter(!(fraction_val == 1),
!(fraction_name == "1"),
Year %in% 1995:2019,
country %in% unlist(completecases)) %>%
mutate(fraction = sub('.*_', '', fraction_name),
fraction = case_when(fraction == "AFSManuf" ~ "AFS Manufacturing",
fraction == "HotelsRestaurants" ~ "Accommodation & Food service",
fraction == "PubAdmin" ~ "Public administration",
fraction == "AccomFood" ~ "Accommodation & Food service",
fraction == "ProfSciTech" ~ "Professional, scientific, & technical activities",
fraction == "ElectricWater" ~ "Electricity, Gas, & Water",
fraction == "WearingApparel" ~ "Wearing Apparel",
fraction == "HealthSocWork" ~ "Health & Social work",
fraction == "Electric" ~ "Electricity, Gas, & Water",
TRUE ~ as.factor(fraction)),
Year = as.numeric(Year),
country = as.character(country))
# Create list of fractions
fraction_list <- unique(data$fraction)
# Write a function for the regression
regress <- function(dat) {
model <- lm(fraction_val ~ Year + country, data = dat)
result <- broom::tidy(model)
# Add 95% confidence interval to the result
conf_int <- broom::confint_tidy(model) # you can use broom::confint() for older versions
result <- cbind(result, conf_int)
return(result) # exits function
}
# Run the regression in a loop over fractions
all_results <- data %>%
group_by(fraction) %>%
do(regress(.))
# Remove coefficients for country and the intercepts
all_results <- all_results %>%
filter(!str_detect(term, "^country")) %>%
filter(term != "(Intercept)") %>%
rename(pval = "p.value")
# Add stars for p-value
all_results <- all_results %>%
mutate(star = case_when(pval < 0.001 ~ "***",
pval >= 0.001 & pval < 0.01 ~ "**",
pval >= 0.01 & pval < 0.05 ~ "*",
pval >= 0.05 ~ "")) %>%
select(fraction, estimate, conf.low, conf.high, star) %>%
# create an ordering variable for the y-axis
mutate(order_var = case_when(fraction == "AFS Manufacturing" ~ 1,
fraction == "Furniture" ~ 2,
fraction == "Leather" ~ 3,
fraction == "Machinery" ~ 4,
fraction == "Chemicals" ~ 5,
fraction == "Wearing Apparel" ~ 6,
fraction == "Textiles" ~ 7,
fraction == "Rubber" ~ 8,
fraction == "Accommodation & Food service" ~ 9,
fraction == "Trade" ~ 10,
fraction == "Transport" ~ 11,
fraction == "Electricity, Gas, & Water" ~ 12,
fraction == "Mining" ~ 13,
fraction == "Professional, scientific, & technical activities" ~ 14,
fraction == "Health & Social work" ~ 15,
fraction == "Public administration" ~ 16,
fraction == "Rentals" ~ 17,
TRUE ~ NA_real_))
# Plot the estimates
ggplot(all_results, aes(y = fct_reorder(fraction, order_var), x = estimate)) +
geom_point() +
geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), width = 0.1) +
geom_text(aes(label = star, x = conf.high), hjust = -.1) +
scale_y_discrete(limits=rev) +
geom_vline(xintercept = 0) +
theme_classic() +
labs(y = "",
x = "Coefficient (95% Confidence Interval)",
caption = "*** p< 0.001, ** p< 0.01, * p < 0.05") +
theme(plot.caption = element_text(hjust = -0.85))
# Save the plot as .png
ggsave(file = file.path(fig_out, "Figure S6.png"), plot = last_plot(), width = 7, units = c("in"), dpi = 300)
# Clean up
rm(all_results, regress, data)
# Set up the data
tabledata <- AFS_ValueAdded %>%
select(c(country, Year, ISIC_Revision)) %>%
rename(Country = country) %>%
unique() %>%
# Use pivot wider then longer to fill in the missing country-years so they show in the legend of the heatmap
pivot_wider(names_from = Year, values_from = ISIC_Revision) %>%
pivot_longer(2:28, names_to = "Year", values_to = "ISIC_Revision")
# Add an ISIC Revision level for no data
levels(tabledata$ISIC_Revision) <- c(levels(tabledata$ISIC_Revision), "No Data")
levels(tabledata$ISIC_Revision)
# Get hex colors
RColorBrewer::brewer.pal(n=2, name = "Paired")
# Print it as a heatmap
ggplot(tabledata,
aes(y = factor(Country, levels = rev(levels(factor(Country)))),
x = factor(Year), fill = factor(ISIC_Revision))) +
geom_tile() +
scale_fill_manual(values = c("#A6CEE3", "#1F78B4"),
na.value = c("white"),
labels = c("Rev 3", "Rev 4", "No data"),
drop = FALSE) +
theme_classic() +
theme(axis.text.x = element_text(size = 6, angle = 90, vjust = 0.5),
axis.text.y = element_text(size = 4),
legend.position = "bottom",
legend.key=element_rect(colour="darkslategray")) +
labs(x = "", y = "", fill = "ISIC Revision")
# Save the plot as .png
ggsave(file = file.path(fig_out, "Figure S7.png"), plot = last_plot(), width = 5, height = 8, units = c("in"),dpi = 300)
# Clean up
rm(tabledata)
# Create a table
countries2019 <- AFS_ValueAdded %>% select(country, Year) %>%
filter(Year == 2019) %>% unique() %>% select(-c("Year"))
table <- flextable(countries2019) %>% autofit()
