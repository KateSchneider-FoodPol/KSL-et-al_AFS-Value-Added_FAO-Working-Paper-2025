# Total value added from agrifood systems, by continent - 2019
tabledata <- AFS_ValueAdded %>% filter(Year == 2019) %>% group_by(UN_continental_region, ISIC_Item) %>%
summarise(Sum_VA_AFS = sum(ValueAdded_cUSD, na.rm = TRUE)) %>%
filter(!(is.na(UN_continental_region))) %>%
filter(!(is.na(ISIC_Item))) %>%
mutate(Sum_VA_AFS = case_when(is.na(Sum_VA_AFS) ~ 0,
TRUE ~ Sum_VA_AFS)) %>%
mutate(Sum_VA_AFS = Sum_VA_AFS / 1000000000) %>% # Convert to billions
pivot_wider(names_from = UN_continental_region, values_from = Sum_VA_AFS) %>%
filter(ISIC_Item != "Other community, social and personal service activities") %>%
rename("ISIC Category" = ISIC_Item) %>%
mutate("Category total" = rowSums(across(where(is.numeric)), na.rm = TRUE))
# Add continent totals
# Create a function to sum by column
add_totals <- function(x) x %>%
ungroup %>%
bind_rows(summarise(., across(where(is.numeric), sum, na.rm = TRUE),
across(where(is.factor), ~ "Total")))
# Append to the data frame
tabledata <- tabledata %>% add_totals
tabledata_unrounded <- tabledata
# Round everything to 2 digits
tabledata <- tabledata %>% mutate_if(is.numeric, round, 2) %>%
# Replace NA with --
mutate(across(.fns = ~ replace_na(as.character(.x), "--"))) %>%
filter(!("ISIC Category" == "--"))
# Create a table
table <- flextable(tabledata) %>% autofit()
# Save table
save_as_docx(table, path = file.path(fig_out, "Table S2.docx"))
# What share of global GDP? And what percent of global population is covered by the 170 countries for which we have data?
# Load global GDP and sum over only the countries in our analysis
# Get WB data
getwbdata <- function(x) {
wb_data <- wbstats::wb(country = "all",
indicator = x,
startdate = 2000,
enddate = 2023,
removeNA = FALSE)
}
### Get World Bank indicators from wbstats package
queries = c("NY.GDP.MKTP.CD","SP.POP.TOTL")
result <- lapply(queries, FUN = getwbdata)
wb_data <- do.call(rbind, result)
# Clean data
wb_data <- wb_data %>%
mutate(indicator = as.factor(indicator))
wb_data <- wb_data %>%
select(-c(iso2c, indicatorID)) %>%
rename(ISO3 = iso3c,
year = date) %>%
filter(year == 2019)
wb_data$country2 <- countrycode::countrycode(wb_data$ISO3, origin = 'iso3c', destination = 'un.name.en', warn = TRUE, nomatch = NA)
wb_data <- wb_data %>% mutate(country2 = case_when(is.na(country2) ~ country,
TRUE ~ country2)) %>%
select(-c("country")) %>% rename(country = country2)
# Match country names
wb_data <- wb_data %>%
mutate(country = case_when(country == "United Kingdom of Great Britain and Northern Ireland" ~ "United Kingdom",
country == "Bolivia (Plurinational State of)" ~ "Bolivia",
country == "Gambia (Republic of The)" ~ "The Gambia",
country == "Iran (Islamic Republic of)" ~ "Iran",
country == "United States of America" ~ "United States",
country == "United Republic of Tanzania" ~ "Tanzania",
country == "Lao People’s Democratic Republic" ~ "Lao PDR",
TRUE ~ country))
world <- wb_data %>%
filter(country == "World") %>%
pivot_wider(names_from = indicator,
values_from = value) %>%
rename("World GDP" = "GDP (current US$)",
"World Population" = "Population, total") %>%
select(2,4,5)
countries_2019_list <- countries2019 %>% pull(country)
hasVAdata <- wb_data %>%
filter(country %in% countries_2019_list) %>%
pivot_wider(names_from = indicator,
values_from = value) %>%
mutate(year = as.numeric(year)) %>%
select(-c(ISO3)) %>%
summarise(across(3:4, ~ sum(.x , na.rm = TRUE)))
hasVAdata <- cbind(hasVAdata, world)
hasVAdata <- hasVAdata %>%
mutate(across(everything(), ~as.numeric(.x))) %>%
mutate(pct_GDP = (`GDP (current US$)` / `World GDP`)*100,
pct_pop = (`Population, total` / `World Population`)*100)
# Note: no GDP data for Venezuela or Yemen
# Clean up
rm(add_totals, table, tabledata, world, wb_data, result, queries, countries_2019_list)
# Set up the data: Summarize value added to the global level by continent
AFS_ValueAdded_CompleteCases <- AFS_ValueAdded %>%
filter(Year %in% 1995:2019) %>%
select(Year, country, UN_continental_region, ValueAdded_AFS_cUSD_Total) %>%
unique() %>% filter(!(is.na(ValueAdded_AFS_cUSD_Total))) %>%
# Limit to complete cases
pivot_wider(names_from = Year, values_from = ValueAdded_AFS_cUSD_Total,
values_fill = NA) %>%
relocate("1995", "1996", "1997", "1998", "1999", "2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019", .after = last_col()) %>%
filter(complete.cases(.))
# Create table listing countries in the complete cases
kable(AFS_ValueAdded_CompleteCases %>% select(country), "html", caption = "Countries with complete data from 1995-2021") %>%
kable_classic(full_width = F, html_font = "Cambria")
# Create a table
tabledata <- AFS_ValueAdded_CompleteCases %>% select(country)
table <- flextable(tabledata) %>% autofit()
# Save table
save_as_docx(table, path = file.path(fig_out, "Table S3.docx"))
