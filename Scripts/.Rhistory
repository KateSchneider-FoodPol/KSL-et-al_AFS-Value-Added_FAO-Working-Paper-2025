toplot <- AFS_ValueAdded %>% filter(Year %in% 2019) %>%
select(c("country", "GDP_cUSD", "population", "UN_continental_region", "ISIC_Item", "ValueAdded_cUSD_pc")) %>%
mutate(GDP_pc = (GDP_cUSD / population)) %>% # convert to per capita
group_by(country, UN_continental_region) %>%
filter(ISIC_Item %in% c("Manufacture of food products and beverages", "Manufacturing (where only aggregate data available)", "Wholesale and retail trade")) %>%
filter(!(is.na(ValueAdded_cUSD_pc))) %>%
filter(!(is.na(UN_continental_region))) %>%
# log the variables
mutate(logGDP_pc = log(GDP_pc),
logValueAdded_cUSD_pc = log(ValueAdded_cUSD_pc))
# Plot
mnf_byincome <- ggplot(toplot %>% filter(ISIC_Item %in% c("Manufacture of food products and beverages", "Manufacturing (where only aggregate data available)")), aes(color=UN_continental_region, y=logValueAdded_cUSD_pc, x=logGDP_pc)) +
geom_point(size = 2) +
scale_color_brewer(palette = "Set1") +
#ylim(0,100) + # allow different y-axes across plots
theme_classic() +
labs(x = "Log GDP per capita (current US$)", y = ("Log Value added per capita (current US$)")) +
ggtitle("Manufacturing of food and beverage") + # Note includes all manufacturing for countries where the disaggregated data are not provided
theme(legend.text = element_text(size = 8),
legend.position="none",
axis.title.x = element_text(size = 6),
axis.title.y = element_text(size = 6),
plot.title = element_text(size = 8)) +
guides(color = guide_legend(title = "Region", override.aes = list(size = 3)))
whrtl_byincome <- ggplot(toplot %>% filter(ISIC_Item == "Wholesale and retail trade"), aes(color=UN_continental_region, y=logValueAdded_cUSD_pc, x=logGDP_pc)) +
geom_point(size = 2) +
scale_color_brewer(palette = "Set1") +
#ylim(0,100) + # allow different y-axes across plots
theme_classic() +
labs(x = "Log GDP per capita (current US$)", y = ("Log Value added per capita (current US$)")) +
ggtitle("Wholesale and retail trade") +
theme(legend.text = element_text(size = 8),
legend.position="none",
